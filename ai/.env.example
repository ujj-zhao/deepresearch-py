# DeepResearch AI 服务配置示例，复制为 .env 后修改
APP_NAME=deepresearch-ai
DEBUG=true

# Postgres（P3 阶段启用，docker-compose 提供 pgvector 镜像）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=deepresearch
POSTGRES_PASSWORD=deepresearch123
POSTGRES_DB=deepresearch

# Redis（与 admin 共享实例，AI 使用 db 1）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# 与 admin 共享的 JWT 密钥（值与 admin/.env 的 JWT_SECRET_KEY 保持一致）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS512
